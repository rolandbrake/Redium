{
  "name": "redium",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "bin": {
    "redium": "./bin/redium.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./render": {
      "types": "./dist/types/render.d.ts",
      "import": "./dist/render.js",
      "require": "./dist/render.cjs"
    },
    "./control": {
      "types": "./dist/types/control.d.ts",
      "import": "./dist/control.js",
      "require": "./dist/control.cjs"
    },
    "./elements": {
      "types": "./dist/types/elements.d.ts",
      "import": "./dist/elements.js",
      "require": "./dist/elements.cjs"
    },
    "./state": {
      "types": "./dist/types/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./store": {
      "types": "./dist/types/store.d.ts",
      "import": "./dist/store.js",
      "require": "./dist/store.cjs"
    },
    "./style": {
      "types": "./dist/types/style.d.ts",
      "import": "./dist/style.js",
      "require": "./dist/style.cjs"
    },
    "./colors": {
      "types": "./dist/types/colors.d.ts",
      "import": "./dist/colors.js",
      "require": "./dist/colors.cjs"
    }
  },
  "scripts": {
    "dev": "node ./bin/redium.mjs dev",
    "typecheck": "tsc --noEmit",
    "build": "node ./bin/redium.mjs build",
    "build:library": "node scripts/build.mjs",
    "preview": "node ./bin/redium.mjs preview",
    "test": "npm run build:library && node --test tests/behavior.test.mjs tests/state.test.mjs tests/store.test.mjs"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
