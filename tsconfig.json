{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "redium": [
        "./src/index.ts"
      ],
      "redium/*": [
        "./*.ts"
      ]
    }
  },
  "include": [
    "src",
    "example",    
    "index.ts"
  ]
}
